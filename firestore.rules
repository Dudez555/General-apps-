rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() <= 150 &&
             (!('phoneNumber' in data) || data.phoneNumber == null || (data.phoneNumber is string && data.phoneNumber.size() <= 30)) &&
             (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 1000));
    }

    function isValidConversation(data) {
      return data.conversationId is string && data.conversationId.size() > 0 && data.conversationId.size() <= 128 &&
             data.type is string && (data.type == 'direct' || data.type == 'group') &&
             data.title is string && data.title.size() <= 100 &&
             data.participantUids is list && data.participantUids.size() > 0 && data.participantUids.size() <= 100 &&
             (!('participantPhones' in data) || (data.participantPhones is list && data.participantPhones.size() <= 100)) &&
             (!('adminUids' in data) || (data.adminUids is list && data.adminUids.size() <= 50)) &&
             (!('lastMessage' in data) || data.lastMessage == null || (data.lastMessage is string && data.lastMessage.size() <= 1000)) &&
             (!('lastMessageSenderId' in data) || data.lastMessageSenderId == null || (data.lastMessageSenderId is string && data.lastMessageSenderId.size() <= 128)) &&
             (!('lastMessageTimestamp' in data) || data.lastMessageTimestamp == null || data.lastMessageTimestamp is timestamp) &&
             (!('isEncrypted' in data) || data.isEncrypted is bool) &&
             (!('webChatSlug' in data) || data.webChatSlug == null || (data.webChatSlug is string && data.webChatSlug.size() <= 128));
    }

    function isValidMessage(data) {
      return data.messageId is string && data.messageId.size() > 0 && data.messageId.size() <= 128 &&
             data.conversationId is string && data.conversationId.size() > 0 && data.conversationId.size() <= 128 &&
             data.senderId is string && data.senderId.size() > 0 && data.senderId.size() <= 128 &&
             data.senderName is string && data.senderName.size() <= 100 &&
             (!('recipientPhone' in data) || data.recipientPhone == null || (data.recipientPhone is string && data.recipientPhone.size() <= 30)) &&
             data.content is string && data.content.size() <= 5000 &&
             (!('encryptedPayload' in data) || data.encryptedPayload == null || (data.encryptedPayload is string && data.encryptedPayload.size() <= 10000)) &&
             data.messageType is string && (data.messageType == 'text' || data.messageType == 'voice' || data.messageType == 'system' || data.messageType == 'call_invite') &&
             (!('audioDurationSec' in data) || data.audioDurationSec is int) &&
             (!('transcription' in data) || data.transcription == null || (data.transcription is string && data.transcription.size() <= 5000)) &&
             (!('status' in data) || (data.status is string && (data.status == 'sending' || data.status == 'delivered' || data.status == 'read'))) &&
             (!('deliveryMode' in data) || (data.deliveryMode is string && (data.deliveryMode == 'wifi_api' || data.deliveryMode == 'web_link' || data.deliveryMode == 'google_chat')));
    }

    // User profiles
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       isValidUserProfile(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUserProfile(incoming());
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Conversations
    match /conversations/{conversationId} {
      allow get: if isSignedIn() && request.auth.uid in existing().participantUids;
      allow list: if isSignedIn() && request.auth.uid in resource.data.participantUids;
      allow create: if isSignedIn() &&
                       request.auth.uid in incoming().participantUids &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       isValidConversation(incoming());
      allow update: if isSignedIn() &&
                       request.auth.uid in existing().participantUids &&
                       isValidConversation(incoming()) &&
                       incoming().createdAt == existing().createdAt;
      allow delete: if isSignedIn() &&
                       (request.auth.uid in existing().adminUids ||
                        (existing().participantUids.size() == 1 && request.auth.uid in existing().participantUids));

      // Messages in conversation
      match /messages/{messageId} {
        allow get, list: if isSignedIn() &&
                            request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids;
        allow create: if isSignedIn() &&
                         incoming().senderId == request.auth.uid &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids &&
                         isValidMessage(incoming());
        allow update: if isSignedIn() &&
                         request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'transcription']);
        allow delete: if isSignedIn() && request.auth.uid == existing().senderId;
      }
    }
  }
}
